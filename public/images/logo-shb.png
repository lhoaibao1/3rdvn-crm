<script>
$(document).ready(function(){
    $(".box_slider").hover(function(){
        $('.box_slider .bx-wrapper .bx-prev').addClass("special");
        $('.box_slider .bx-wrapper .bx-next').addClass("special");
    }, function(){
         $('.box_slider .bx-wrapper .bx-prev').removeClass("special");
         $('.box_slider .bx-wrapper .bx-next').removeClass("special");
    });
});
</script>
